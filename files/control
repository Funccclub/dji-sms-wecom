#!/bin/sh
if [ "$#" -eq 4 ] && [ "$1" = submit-sms ]; then
  exec /usr/sbin/dji-sms-wecom "$@"
fi
if [ "$#" -eq 2 ] && [ "$1" = send-status ]; then
  exec /usr/sbin/dji-sms-wecom "$@"
fi
if [ "$#" -eq 2 ] && { [ "$1" = history ] || [ "$1" = outgoing-history ]; }; then
  exec /usr/sbin/dji-sms-wecom "$@"
fi
[ "$#" -eq 1 ] || exit 2
case "$1" in
  start) /etc/init.d/dji-sms-wecom enable && /etc/init.d/dji-sms-wecom restart ;;
  stop) /etc/init.d/dji-sms-wecom disable && /etc/init.d/dji-sms-wecom stop ;;
  status) /etc/init.d/dji-sms-wecom status ;;
  *) exit 2 ;;
esac
